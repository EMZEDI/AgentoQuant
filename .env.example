# AgentoQuant — credential variable names
#
# THIS FILE IS A TEMPLATE. It holds names and placeholders, never real values, and is safe to commit.
#
# The real file lives OUTSIDE the repo at:
#     ~/.config/agentoquant/credentials.env     (mode 600)
# and is never printed, logged, echoed or committed. `agentoquant/config_loader.py` refuses to start
# if that file is missing or its mode is more permissive than 600.
#
# Copy this file there and fill in the values:
#     install -m 600 /dev/null ~/.config/agentoquant/credentials.env
#     $EDITOR ~/.config/agentoquant/credentials.env

# --- Kraken (spot only) -------------------------------------------------------------------------
# Permissions required: Query Funds, Query Open Orders & Trades, Query Closed Orders & Trades,
# Create & Modify Orders, Cancel/Close Orders.
# Permissions NOT to grant: Withdraw Funds, and any funding/deposit permission. The agent never
# moves fiat and never withdraws; funding is manual, triggered by a Telegram card Shahrad answers.
# Add both the IPv4 and the IPv6 address of this host to the key's allowlist: Kraken keeps separate
# allowlists per protocol, and a missing IPv6 entry causes intermittent auth failures.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- LLM (the project's own key, separate from Hermes' own keys) ---------------------------------
# Every model call in the pipeline goes through this key, including the Sonnet-class roles, so the
# ledger has one cost path. Monthly limit ≈ $71 USD (100 CAD); the cap that matters is
# config/settings.yaml -> llm.monthly_cost_cap_cad (130 CAD, covering coding work too).
AGENTOQUANT_OPENROUTER_KEY=

# --- Market data ---------------------------------------------------------------------------------
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Usage, unlocks ------------------------------------------------------------------------------
# CryptoRank free Sandbox plan: /v2 base with an X-Api-Key header. Note that vesting/unlock
# endpoints are NOT included in the free plan (Pro only), so unlock data is best-effort and its
# absence fails closed for sleeve C.
CRYPTORANK_API_KEY=

# --- Optional but recommended --------------------------------------------------------------------
# CoinGecko works keyless; a demo key raises the rate limit.
COINGECKO_API_KEY=

# --- On-chain webhooks (either one is enough for Task 4) -----------------------------------------
ALCHEMY_API_KEY=
HELIUS_API_KEY=

# --- Not in this file ----------------------------------------------------------------------------
# Telegram reuses the existing Hermes bot: TELEGRAM_BOT_TOKEN and TELEGRAM_HOME_CHANNEL are read from
# ~/.hermes/.env. Do not duplicate the token here — the Hermes gateway owns the inbound polling path,
# and Telegram allows exactly one polling consumer.
